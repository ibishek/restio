---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Footer.astro';

const { entry } = Astro.locals.starlightRoute;
const isSplash = entry?.data?.template === 'splash';
---

<Default {...Astro.props}><slot /></Default>

{isSplash && (
<footer class="restio-footer">
	<div class="footer-grid">
		<!-- Brand & Mission -->
		<div class="footer-col brand-col">
			<div class="brand-header">
				<img src="/favicon.png" alt="RestIO Logo" width="28" height="28" class="brand-logo" />
				<span class="brand-title">RestIO</span>
			</div>
			<p class="brand-desc">
				A fast, shareable REST API client for your desktop. Native Rust HTTP engine, Git-backed team collections, sandboxed JavaScript tests, and zero CORS limits.
			</p>
			<div class="brand-meta">
				<span class="badge">MIT Licensed</span>
				<span class="badge">Tauri v2</span>
				<span class="badge">Rust Core</span>
			</div>
		</div>

		<!-- Documentation Links -->
		<div class="footer-col">
			<h4 class="col-title">Documentation</h4>
			<ul class="col-links">
				<li><a href="/getting-started/introduction/">Introduction</a></li>
				<li><a href="/getting-started/installation/">Installation</a></li>
				<li><a href="/getting-started/quickstart/">Quickstart Guide</a></li>
				<li><a href="/core/workspaces-collections/">Workspaces & Collections</a></li>
				<li><a href="/core/http-engine/">Rust HTTP Engine</a></li>
				<li><a href="/core/environments/">Environments & Variables</a></li>
			</ul>
		</div>

		<!-- Features Links -->
		<div class="footer-col">
			<h4 class="col-title">Features</h4>
			<ul class="col-links">
				<li><a href="/collaboration/git-sync/">Git-Backed Sharing</a></li>
				<li><a href="/testing/scripting/">Scripting Runtime</a></li>
				<li><a href="/testing/assertions/">Test Assertions</a></li>
				<li><a href="/testing/mock-data/">Faker Mock Data</a></li>
				<li><a href="/testing/collection-runner/">Collection Runner</a></li>
				<li><a href="/interoperability/openapi-swagger/">OpenAPI & Swagger</a></li>
			</ul>
		</div>

		<!-- Resources Links -->
		<div class="footer-col">
			<h4 class="col-title">Resources</h4>
			<ul class="col-links">
				<li><a href="/reference/rio-api/"><code>rio.*</code> Scripting API</a></li>
				<li><a href="/reference/keyboard-shortcuts/">Keyboard Shortcuts</a></li>
				<li><a href="/reference/architecture/">Architecture Blueprint</a></li>
				<li><a href="https://github.com/ibishek/restio" target="_blank" rel="noopener noreferrer">GitHub Repository ↗</a></li>
				<li><a href="https://github.com/ibishek/restio/releases" target="_blank" rel="noopener noreferrer">Releases & Downloads ↗</a></li>
				<li><a href="https://github.com/ibishek/restio/issues" target="_blank" rel="noopener noreferrer">Report an Issue ↗</a></li>
			</ul>
		</div>
	</div>

	<!-- Bottom Copyright Bar -->
	<div class="footer-bottom">
		<p class="copyright">
			&copy; {new Date().getFullYear()} RestIO. Free &amp; open source under the <a href="https://github.com/ibishek/restio/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">MIT License</a>.
		</p>
		<p class="credits">
			Built with <a href="https://starlight.astro.build" target="_blank" rel="noopener noreferrer">Starlight</a> &amp; <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
		</p>
	</div>
</footer>
)}

<style>
	.restio-footer {
		margin-top: 4rem;
		padding-top: 3rem;
		border-top: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr 1fr;
		gap: 2.5rem 2rem;
		margin-bottom: 3rem;
	}

	@media (max-width: 900px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}
		.brand-col {
			grid-column: span 2;
		}
	}

	@media (max-width: 600px) {
		.footer-grid {
			grid-template-columns: 1fr;
		}
		.brand-col {
			grid-column: span 1;
		}
	}

	.brand-col {
		padding-right: 1.5rem;
	}

	.brand-header {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin-bottom: 0.75rem;
	}

	.brand-logo {
		border-radius: 6px;
	}

	.brand-title {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--sl-color-white);
		letter-spacing: -0.02em;
	}

	.brand-desc {
		line-height: 1.6;
		margin-bottom: 1.25rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}

	.brand-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.badge {
		font-size: 0.75rem;
		padding: 0.2rem 0.6rem;
		border-radius: 9999px;
		background-color: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
		border: 1px solid var(--sl-color-gray-5);
		font-weight: 500;
	}

	.col-title {
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--sl-color-white);
		margin-bottom: 1rem;
	}

	.col-links {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.col-links a {
		color: var(--sl-color-gray-3);
		text-decoration: none;
		transition: color 0.15s ease;
		display: inline-block;
	}

	.col-links a:hover {
		color: var(--sl-color-accent-high);
	}

	.col-links code {
		font-size: 0.8em;
		padding: 0.1em 0.3em;
		background: var(--sl-color-gray-6);
		border-radius: 4px;
	}

	.footer-bottom {
		padding-top: 1.5rem;
		border-top: 1px solid var(--sl-color-gray-6);
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-4);
	}

	.footer-bottom a {
		color: var(--sl-color-gray-3);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.footer-bottom a:hover {
		color: var(--sl-color-white);
	}

	.copyright {
		margin: 0;
	}

	.credits {
		margin: 0;
	}
</style>
